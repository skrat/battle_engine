# Common settings
API_KEY_HEADER=X-API-Key
API_KEY_SECRET=42

STAT_HEADER=X-Battle-Lock-Stat
STAT_HEADER_FLAG=1

BATTLE_LOCK_TTL=2
BATTLE_LOCK_POLL_INTERVAL=0.002
BATTLE_LOCK_MAX_POLL=2

# Redis backend
BACKEND=battle_engine.backend.redis.impl:RedisBackend
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=750
REDIS_TIMEOUT=30

